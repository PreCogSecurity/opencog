# OpenCog Environment Configuration Example
# Copy this file to .env before running docker-compose up

# Database Configuration (Postgres backend for AtomSpace / persistence)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=opencog
POSTGRES_PASSWORD=opencog_secret
POSTGRES_DB=opencog

# Server Configuration
COGSERVER_PORT=17001
SERVER_CYCLE_DURATION=10
LOG_LEVEL=INFO
